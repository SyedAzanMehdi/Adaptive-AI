# ---------------------------------------------------------------------------
# Server environment template — copy to `server/.env` and fill in real values.
#   cp server/.env.example server/.env
# NEVER commit the real .env (it is git-ignored). This file holds PLACEHOLDERS
# only, so contributors know which variables exist and what shape they take.
#
# The app runs with NO .env at all in development: it boots an embedded
# MongoDB (persisted to server/mongo-data) and uses the deterministic mock AI.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
PORT=5000
NODE_ENV=development            # development | test | production

# --- Database --------------------------------------------------------------
# Leave EMPTY in dev to use the embedded MongoDB (persists to server/mongo-data;
# delete that folder for a clean slate). REQUIRED in production.
#   Local:    mongodb://127.0.0.1:27017/adaptive_learning
#   Atlas:    mongodb+srv://<user>:<password>@<cluster>.mongodb.net/adaptive_learning
MONGO_URI=
# Optional: override where the embedded dev database stores its files.
EMBEDDED_DB_PATH=

# --- Auth / JWT ------------------------------------------------------------
# Use a long random string in production, e.g. `openssl rand -hex 64`.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Seeded admin (created on first boot only if no admin exists) ----------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe1234!

# --- Gemini AI -------------------------------------------------------------
# Add a key to switch AI orchestration from the deterministic mock to Gemini.
# Keys are secret — never paste real ones into this template.
GEMINI_API_KEY=
# Optional second key. The keys are PARTITIONED BY FEATURE: this one pays for
# the heavier paths (adaptive diagnostic + its prefetch, lesson adaptation,
# code evaluation, Dojo critique, Career Autopilot, Freelance Launchpad) while
# GEMINI_API_KEY above pays for Ask AI, so bulk generation can't starve the
# chat. It's a preference, not a wall — every feature still tries the other
# key, then the deterministic mock. Leave blank to run everything on key 1.
# Success is logged with the serving credential ("... ok via key 2").
GEMINI_API_KEY_2=
# Primary model, then a comma-separated fallback list (tried in order).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3-flash-preview
# Per-attempt timeout (ms). Free tier can spike to 3-10s under load; 12000 is
# a safe dev value. Production on a paid key can use ~10000.
AI_TIMEOUT_MS=12000

# --- CORS (production only) ------------------------------------------------
# Comma-separated list of allowed browser origins. Same-origin deploys (client
# and API served from one Vercel project) need none. Dev is permissive.
#   CORS_ORIGIN=https://app.yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=

# --- Build / deploy --------------------------------------------------------
# Skip the mongodb-memory-server binary download in CI/serverless builds where
# the embedded dev DB is never used (production requires MONGO_URI).
MONGOMS_DISABLE_POSTINSTALL=1
