# ---------------------------------------------------------------------------
# Client environment template — copy to `client/.env` and adjust if needed.
#   cp client/.env.example client/.env
# Values prefixed with VITE_ are exposed to the browser at build time, so never
# put secrets here. This is the API base URL the SPA calls.
#
# Default (same-origin): the Vite dev proxy and the Vercel single-project deploy
# both serve the API under /api, so the relative path works with no override.
# Set an absolute URL only if the API lives on a different origin.
#
# LEAVE THIS BLANK for both local dev and Vercel. Setting it to
# http://localhost:5000/api/v1 in the Vercel project env would ship a build
# that calls each visitor's own machine instead of the deployed API.
# ---------------------------------------------------------------------------
VITE_API_URL=
